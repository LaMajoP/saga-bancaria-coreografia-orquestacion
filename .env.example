# Copy this file to .env and replace every placeholder with a Supabase
# PostgreSQL connection string. Never commit .env or real credentials.
# URL-encode reserved password characters such as @, :, /, ?, #, [, or ].
ACCOUNT_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
GATEWAY_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
RISK_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
CLEARING_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SAGA_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
RISK_MAX_AMOUNT=1000000
CLEARING_LATENCY_SECONDS=0
CLEARING_TIMEOUT_SECONDS=3

# Use a separate remote Supabase development/test project for these values.
TEST_ACCOUNT_DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
TEST_GATEWAY_DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
TEST_RISK_DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
TEST_CLEARING_DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
