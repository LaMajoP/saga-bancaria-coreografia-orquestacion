# Copy this file to .env and replace every placeholder with a Supabase
# PostgreSQL connection string. Never commit .env or real credentials.
# URL-encode reserved password characters such as @, :, /, ?, #, [, or ].
# Usa el pooler en MODO TRANSACCION (puerto 6543). El de modo sesion (5432)
# limita todo el proyecto a 15 clientes y seis procesos lo agotan solos.
ACCOUNT_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
GATEWAY_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
RISK_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
CLEARING_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
SAGA_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
RISK_MAX_AMOUNT=1000000
CLEARING_LATENCY_SECONDS=0
CLEARING_TIMEOUT_SECONDS=3

# Use a separate remote Supabase development/test project for these values.
TEST_ACCOUNT_DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
TEST_GATEWAY_DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
TEST_RISK_DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
TEST_CLEARING_DATABASE_URL=postgresql://postgres.TEST_PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# --- Capa Saga (Persona 2) ---
SAGA_SERVICE_URL=http://127.0.0.1:8004
SAGA_ORCHESTRATOR_URL=http://127.0.0.1:8004
GATEWAY_URL=http://127.0.0.1:8000
ACCOUNT_SERVICE_URL=http://127.0.0.1:8001
RISK_SERVICE_URL=http://127.0.0.1:8002
CLEARING_SERVICE_URL=http://127.0.0.1:8003
# ORCHESTRATION o CHOREOGRAPHY. Se puede sobreescribir por peticion con el
# header X-Saga-Mode, para alternar las dos modalidades durante la demo.
SAGA_MODE=ORCHESTRATION
# Protege el endpoint interno con el que la Saga reporta el estado final.
SAGA_INTERNAL_TOKEN=cambia-este-token
# Pausa entre micro-pasos para poder observar el avance (2 a 4 segundos).
SAGA_STEP_DELAY_SECONDS=3
SAGA_USE_PREFECT=true
# Consola de Prefect: http://localhost:4200
PREFECT_PORT=4200
SAGA_NOTIFY_GATEWAY=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
SAGA_EXCHANGE=saga.events

# Conexiones por proceso. Con el pooler en modo transaccion hay margen de sobra.
DB_POOL_MAX_SIZE=3
